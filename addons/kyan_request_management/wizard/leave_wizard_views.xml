<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="leave_wizard_view_form" model="ir.ui.view">
        <field name="name">leave.wizard.view.form</field>
        <field name="model">leave.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="holiday_status_id" required='1'/>
                </group>
                <footer>
                    <button name="action_create_leave"
                            string="Generate Leave" type="object"
                            class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="leave_wizard_action" model="ir.actions.act_window">
        <field name="name">Leave</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">leave.wizard</field>
        <field name="view_mode">form</field>
    </record>
</odoo>
