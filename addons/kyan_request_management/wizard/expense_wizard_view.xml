<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="expense_wizard_view_form" model="ir.ui.view">
        <field name="name">expense.wizard.view.form</field>
        <field name="model">expense.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="name" string="Description"/>
                        <field name="product_id" string="Product"/>
                        <field name="total_amount" optional="show" widget="monetary" options="{'currency_field': 'currency_id'}" decoration-bf="True"/>
                        <field name="currency_id" optional="hide" groups="base.group_multi_currency"/>
                    </group>
                    <group>
                        <field name="expense_date" string="Expense Date"/>
                        <field name="payment_mode" string="Paid By"/>
                    </group>
                </group>
                <footer>
                    <button name="create_expense"
                            string="Generate Expense" type="object"
                            class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="expense_wizard_action" model="ir.actions.act_window">
        <field name="name">Expense</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">expense.wizard</field>
        <field name="view_mode">form</field>
    </record>
</odoo>
