<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form View -->
    <record id="view_rest_api_target_model_form" model="ir.ui.view">
        <field name="name">rest.api.target.model.form</field>
        <field name="model">rest.api.target.model</field>
        <field name="arch" type="xml">
            <form string="Target Model">
                <header>
                    <button name="action_test_request" string="Test Request" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Model Name (e.g. res.partner)"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="connection_id"/>
                            <field name="method"/>
                            <field name="sync_interval"/>
                            <field name="auto_sync"/>
                            <field name="unique_field" placeholder="e.g. email" invisible="auto_sync != 0"/>
                        </group>
                        <group>
                            <field name="selected_fields" placeholder='["id", "name"]'/>
                            <field name="rec_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload">
                             <field name="request_body" placeholder='{"name": "New Value"}'/>
                        </page>
                        <page string="Result">
                            <field name="result" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_rest_api_target_model_tree" model="ir.ui.view">
        <field name="name">rest.api.target.model.tree</field>
        <field name="model">rest.api.target.model</field>
        <field name="arch" type="xml">
            <tree string="Target Models">
                <field name="name"/>
                <field name="method"/>
                <field name="connection_id"/>
            </tree>
        </field>
    </record>

    <!-- Action -->
    <record id="action_rest_api_target_model" model="ir.actions.act_window">
        <field name="name">Models</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">rest.api.target.model</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_rest_api_target_models"
              name="Target Models"
              parent="rest_api_root"
              sequence="30"/>

    <menuitem id="menu_rest_api_target_model_sub"
              name="Models"
              parent="menu_rest_api_target_models"
              action="action_rest_api_target_model"
              sequence="10"/>

</odoo>
