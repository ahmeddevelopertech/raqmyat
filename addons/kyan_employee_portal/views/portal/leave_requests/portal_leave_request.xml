                    <div class="mian_content mt-5 mt-md-5 mt-md-5 ml-md-5">
                        <h5 style="color: #345E90;" class="ml-3 ml-md-0">Leave Policy</h5>
                        <form id="leaveRequestForm">
                            <div class="p-4 section-color">
                                <div class="form-row">
                                    <div class="form-group col-12 col-md-4 pl-md-3 mt-n2 mt-md-0 ">
                                        <label for="leave_type" class="custom_label_color">
                                            Leave Type
                                        </label>

                                        <select id="leave_type"
                                                class="form-control form1-label-colors custom-select">
                                            <option value=""
                                                    t-att-selected="selected">
                                                Select Leave Type
                                            </option>
                                            <t t-foreach="leave_types" t-as="option">
                                                <option t-att-value="option.id">
                                                    <t t-esc="option.name"/>
                                                </option>
                                            </t>
                                        </select>
                                        <div class="error">

                                        </div>
                                    </div>
                                    <div class="form-group col-md-4 px-3">
                                        <label for="leave_date_form" class="custom_label_color">From</label>
                                        <input type="date" name="leave_date_form" id="leave_date_form"
                                               class="form-control"
                                               placeholder="From Date"/>
                                        <div class="error"></div> <!-- Error display for 'expense_date' -->
                                    </div>
                                    <div class="form-group col-md-4 px-3">
                                        <label for="leave_date_to" class="custom_label_color">To</label>
                                        <input type="date" name="leave_date_to" id="leave_date_to" class="form-control"
                                               placeholder="From Date"/>
                                        <div class="error"></div> <!-- Error display for 'expense_date' -->
                                    </div>
                                </div>
                                <div class="form-row ">
                                    <div class="form-group col-12 col-md-4 pl-md-3 mt-n2 mt-md-0">
                                        <label for="leave_document_attachment"
                                               class="custom_label_color">
                                            Attachment
                                        </label>

                                        <div class="custom-file ">
                                            <input type="file" class="custom-file-input form1-label-colors"
                                                   id="leave_document_attachment"/>
                                            <label class="custom-file-label form1-label-colors"
                                                   for="qualification_document_attachment">
                                                Choose file ...
                                            </label>
                                        </div>
                                        <div class="error">
                                        </div>
                                    </div>
                                    <!--                                    <div class="form-group col-12 col-md-4 pl-md-3 mt-n2 mt-md-0 ">-->
                                    <!--                                        <label for="total_leave_days" class="custom_label_color">-->
                                    <!--                                            No. Of Days-->
                                    <!--                                        </label>-->
