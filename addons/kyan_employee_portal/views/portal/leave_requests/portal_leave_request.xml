                                    <!--                                               placeholder="0"-->
                                    <!--                                               disabled="disabled"/>-->
                                    <!--                                        <div class="error">-->

                                    <!--                                        </div>-->
                                    <!--                                    </div>-->
                                </div>
                                <div class="form-row">
                                    <div class="form-group col-12  pl-md-3 mt-n2 mt-md-0">
                                        <label for="leave_description" class="custom_label_color">Reason, Justification
                                            and supporting documents are required for other than Annual Leaves
                                        </label>
                                        <textarea class="form-control form1-label-colors" id="leave_description"
                                                  rows="3"/>
                                        <div class="error">

                                        </div>
                                    </div>

                                </div>
                            </div>
                            <div class="row pr-2 pr-md-2 pt-2 justify-content-end">
                                <div class="col-4 text-right">
                                    <!--                                        <button type="submit" class="btn" style="background:#345E90; color:#fff">Back To List</button>-->
                                    <a t-attf-href="/leave_requests_details" class="btn btn-primary"
                                       style="background:#345E90; color:#fff;">
                                        Back to List
                                    </a>
                                    <button type="submit" class="btn" style="background:#345E90; color:#fff">Create
                                        Request
                                    </button>
                                </div>
                            </div>


                        </form>
                    </div>

                </div>
                <script src="https://cdn.jsdelivr.net/npm/sweetalert2@10"/>
