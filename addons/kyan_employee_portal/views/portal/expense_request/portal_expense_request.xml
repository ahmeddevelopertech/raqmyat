<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="portal_expense_request" name="Requisition_request" customize_show="True" priority="30">
        <t t-call="web.layout">
            <t t-set="title">Expense Request</t>
            <head>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"/>
                <link rel="stylesheet" type="text/css" href="/kyan_employee_portal/static/src/css/forms_design.css"/>
                <link rel="stylesheet"
                      href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/css/bootstrap-datepicker.min.css"/>
            </head>
            <body>
                <t t-call="kyan_employee_portal.portal_navigation"/>
                <div class="content">
                    <h4 class="ml-2 ml-md-5 mt-3 heading_text_control">EXPENSE REQUEST</h4>
                    <p class="ml-2 ml-md-5 mt-n1 mt-md-0 subheading_text_control" style="color: #345E90;">
                        Expense Request
                    </p>
                    <hr/>
                    <div class="mian_content mt-5  mt-md-5 mt-md-5 ml-md-5">
                        <h5 style="color: #345E90;" class="ml-3 ml-md-0">Requested By</h5>
                        <div class="p-4 section-color">
                            <div class="form-row">
                                <div class="form-group col-md-4 px-3">
                                    <label for="badge_id" class="form1-label-colors">Badge ID</label>
                                    <input type="text" t-att-value="employee_info.barcode" class="form-control"
                                           id="employee_id" placeholder="" disabled="disabled"/>
                                </div>
                                <div class="form-group col-md-4 px-3">
                                    <label for="employee_name" class="form1-label-colors">Employee Name</label>
                                    <input type="text" t-att-value="employee_info.name" class="form-control"
                                           id="employee_name" placeholder="" disabled="disabled"/>
                                </div>
                                <div class="form-group col-md-4 px-3">
                                    <label for="employee_position" class="form1-label-colors">Position</label>
                                    <input type="text" t-att-value="employee_info.job_id.name" class="form-control"
                                           id="employee_position" placeholder="" disabled="disabled"/>
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group col-md-4 px-3">
                                    <label for="employee_department" class="form1-label-colors">Department
                                    </label>
                                    <input type="text" t-att-value="employee_info.department_id.name"
                                           class="form-control" id="employee_department" placeholder=""
                                           disabled="disabled"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <form id="expenseRequestForm">
                        <div class="mian_content mt-5 mt-5 ml-0 ml-md-5">
                            <h5 style="color: #345E90;" class="ml-3 ml-md-0">Create Request</h5>
                            <div class="section-color p-4">
                                <div class="form-row mt-3">
                                    <div class="form-group col-md-4 px-3">
                                        <label for="product" class="custom_label_color">Expense Name</label>
                                        <select class="form-control" id="product" name="product" required="True">
                                            <t t-foreach="product" t-as="product">
                                                <option t-att-value="product.id">
                                                    <span t-esc="product.name"/>
                                                </option>
                                            </t>
                                        </select>
                                        <div class="error"></div>
                                    </div>

                                    <div class="form-group col-md-4 px-3">
                                        <label for="unit_price" class="custom_label_color">Unit Price</label>
                                        <input type="number" name="unit_price" id="unit_price" class="form-control"
                                               placeholder="Unit Price"/>
                                        <div class="error"></div> <!-- Error display for 'unit_price' -->
                                    </div>

                                    <div class="form-group col-md-4 px-3">
                                        <label for="expense_date" class="custom_label_color">Expense Date</label>
                                        <input type="date" name="expense_date" id="expense_date" class="form-control"
                                               placeholder="Expense Date"/>
                                        <div class="error"></div>
                                    </div>
                                </div>

                                <div class="form-row mt-3">
                                    <div class="form-group col-md-4 px-3">
                                        <label for="quantity" class="custom_label_color">Quantity</label>
                                        <input type="number" name="quantity" id="quantity" class="form-control"
                                               placeholder="Quantity"/>
                                        <div class="error"></div> <!-- Error display for 'quantity' -->
                                    </div>

                                    <div class="form-group col-md-4 px-3">
                                        <label for="bill_reference" class="custom_label_color">Bill Reference</label>
                                        <input type="text" name="bill_reference" id="bill_reference"
                                               class="form-control"
                                               placeholder="Bill Reference"/>
                                        <div class="error"></div> <!-- Error display for 'bill_reference' -->
                                    </div>

                                    <!--                                    <div class="form-group col-12 col-md-4 pl-md-3 mt-n2 mt-md-0">-->
                                    <!--                                        <label for="leave_document_attachment"-->
                                    <!--                                               class="custom_label_color">-->
                                    <!--                                            Attachment-->
                                    <!--                                        </label>-->

                                    <!--                                        <div class="custom-file ">-->
                                    <!--                                            <input type="file" class="custom-file-input form1-label-colors"-->
                                    <!--                                                   id="leave_document_attachment"/>-->
                                    <!--                                            <label class="custom-file-label form1-label-colors"-->
                                    <!--                                                   for="qualification_document_attachment">-->
                                    <!--                                                Choose file ...-->
                                    <!--                                            </label>-->
                                    <!--                                        </div>-->
                                    <!--                                        <div class="error">-->
                                    <!--                                        </div>-->
                                    <!--                                    </div>-->
                                    <div class="form-group col-12 col-md-4 pl-md-3 mt-n2 mt-md-0">
                                        <label for="leave_document_attachment" class="custom_label_color">
                                            Attachment
                                        </label>

                                        <div class="custom-file">
                                            <input type="file" class="custom-file-input form1-label-colors"
                                                   id="leave_document_attachment"
                                                   onchange="updateFileName()"/>
                                            <label class="custom-file-label form1-label-colors" id="fileLabel"
                                                   for="leave_document_attachment">
                                                Choose file ...
                                            </label>
                                        </div>
                                        <div class="error"></div>
                                    </div>


                                </div>
                                <div class="row pr-2 pr-md-2 pt-2 justify-content-end">
                                    <div class="col-4 text-right">
                                        <!--                                        <button type="submit" class="btn" style="background:#345E90; color:#fff">Back To List</button>-->
                                        <a t-attf-href="/expense_requests" class="btn btn-primary"
                                           style="background:#345E90; color:#fff;">
                                            Back to List
                                        </a>
                                        <button type="submit" class="btn" style="background:#345E90; color:#fff">Create
                                            Request
                                        </button>
                                    </div>
                                </div>

                                <!--                                <div class="row pr-2 pr-md-2 pt-2">-->
                                <!--                                    <div class="col-8 text-right"/>-->
                                <!--                                    <div class="col-2 text-right">-->
                                <!--                                        <button type="submit" class="btn" style="background:#345E90; color:#fff">Back To List</button>-->
                                <!--                                    </div>-->
                                <!--                                    <div class="col-2 text-right">-->
                                <!--                                        <button type="submit" class="btn" style="background:#345E90; color:#fff">Create Request</button>-->
                                <!--                                    </div>-->
                                <!--                                </div>-->
                            </div>
                        </div>
                    </form>
                </div>
                <div id="overlay"></div>
                <!--                <script src="https://code.jquery.com/jquery-3.6.0.min.js"/>-->
                <script src="https://cdn.jsdelivr.net/npm/sweetalert2@10"/>
                <script type="module" src="/kyan_employee_portal/static/src/js/expense_request.js"/>
                <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"/>
                <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/js/bootstrap-datepicker.min.js"></script>
                <script type="script" src="kyan_employee_portal/static/src/js/overlay.js"/>
                <script>
                    function updateFileName() {
                    var fileInput = document.getElementById('leave_document_attachment');
                    var fileLabel = document.getElementById('fileLabel');
                    if (fileInput.files.length > 0) {
                    fileLabel.textContent = fileInput.files[0].name;
                    } else {
                    fileLabel.textContent = 'Choose file ...';
                    }
                    }
                </script>

            </body>
        </t>
    </template>
</odoo>

