                                                </td>
                                                <td class="align-middle">
                                                    <t t-if="details.types">
                                                        <span t-field="details.state"/>
                                                    </t>
                                                    <t t-else="">
                                                        State
                                                    </t>
                                                </td>
                                                <td class="align-middle">
                                                    <a t-attf-href="/salary_loan_request/#{details.id}"
                                                       class="btn btn-sm btn-success mt-auto">View
                                                    </a>
                                                </td>
                                            </tr>
