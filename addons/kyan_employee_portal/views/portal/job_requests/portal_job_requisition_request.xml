                                                <div class="error">

                                                </div>
                                            </div>
                                            <div class="col-12 col-md-4 mb-2">
                                                <input type="text" class="form-control form1-label-colors"
                                                       id="building_name"
                                                       t-att-disabled="'disabled' if job_request.building_name else None"
                                                       t-att-value="job_request.building_name"
                                                       placeholder="Business"/>
                                                <div class="error">

                                                </div>
                                            </div>

                                        </div>
                                        <div class="error_space_availability">

                                        </div>
                                    </div>
                                </div>
