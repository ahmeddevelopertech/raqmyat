<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template id="portal_accident_request" name="Requisition_request" customize_show="True" priority="30">
        <t t-call="web.layout">
            <t t-set="title">Accident / Incident Request</t>
            <head>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css"/>
                <link rel="stylesheet" type="text/css" href="/kyan_employee_portal/static/src/css/forms_design.css"/>
                <link rel="stylesheet"
                      href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/css/bootstrap-datepicker.min.css"/>
            </head>
            <body>
                <t t-call="kyan_employee_portal.portal_navigation"/>
                <div class="content">
                    <h4 class="ml-2 ml-md-5 mt-3 heading_text_control">ACCIDENT / INCIDENT REQUEST</h4>
                    <p class="ml-2 ml-md-5 mt-n1 mt-md-0 subheading_text_control" style="color: #345E90;">
                        Accident / Incident Request
                    </p>
                    <hr/>
                    <div class="mian_content mt-5  mt-md-5 mt-md-5 ml-md-5">
                        <h5 style="color: #345E90;" class="ml-3 ml-md-0">Requested By</h5>
                        <div class="p-4 section-color">
                            <div class="form-row">
                                <div class="form-group col-md-4 px-3">
                                    <label for="employee_id" class="form1-label-colors">Badge ID</label>
                                    <input type="text" t-att-value="employee_info.barcode" class="form-control"
                                           id="employee_id" placeholder="" disabled="disabled"/>
                                </div>
                                <div class="form-group col-md-4 px-3">
                                    <label for="employee_name" class="form1-label-colors">Employee Name</label>
                                    <input type="text" t-att-value="employee_info.name" class="form-control"
                                           id="employee_name" placeholder="" disabled="disabled"/>
                                </div>
                                <div class="form-group col-md-4 px-3">
                                    <label for="employee_position" class="form1-label-colors">Position</label>
                                    <input type="text" t-att-value="employee_info.job_id.name" class="form-control"
                                           id="employee_position" placeholder="" disabled="disabled"/>
                                </div>
                            </div>
                            <div class="form-row">
                                <div class="form-group col-md-4 px-3">
                                    <label for="employee_department" class="form1-label-colors">Department
                                    </label>
                                    <input type="text" t-att-value="employee_info.department_id.name"
                                           class="form-control" id="employee_department" placeholder=""
                                           disabled="disabled"/>
                                </div>
                            </div>
                        </div>
                    </div>
                    <form id="accidentRequestForm">
                        <div class="mian_content mt-5 mt-5 ml-0 ml-md-5">
                            <h5 style="color: #345E90;" class="ml-3 ml-md-0">Create Request</h5>
                            <div class="section-color p-4">
                                <div class="form-row mt-3">
                                    <div class="form-group col-md-4 px-3">
                                        <label for="product" class="custom_label_color">Incident Type</label>
                                        <select name="incident_type" id="incident_type" t-attf-class="form-control">
                                            <option value="accident">Accident</option>
                                            <option value="incident">Incident</option>
                                        </select>
                                        <div class="error"></div> <!-- Error display for 'product' -->
                                    </div>

                                    <div class="form-group col-md-4 px-3">
                                        <label for="type_of_inquiry" class="custom_label_color">Type of Inquiry</label>
                                        <select name="type_of_inquiry" id="type_of_inquiry" t-attf-class="form-control">
                                            <option value="fatal">Fatal</option>
                                            <option value="non_fatal">Non Fatal</option>
                                        </select>
                                        <div class="error"></div>
                                    </div>

                                    <div class="form-group col-md-4 px-3">
                                        <label for="hospital" class="custom_label_color">Hospital</label>
                                        <input type="text" name="hospital" id="hospital" class="form-control"
                                               placeholder="Hospital"/>
                                        <div class="error"></div> <!-- Error display for 'quantity' -->
                                    </div>
                                </div>

                                <div class="form-row mt-3">
                                    <div class="form-group col-md-4 px-3">
                                        <label for="occupation" class="custom_label_color">Occuptation</label>
                                        <input type="text" name="occupation" id="occupation" class="form-control"
                                               placeholder="Occupation"/>
                                        <div class="error"></div> <!-- Error display for 'quantity' -->
                                    </div>
                                    <div class="form-group col-md-4 px-3">
                                        <label for="wiba" class="custom_label_color">Wiba Compensation</label>
                                        <input type="text" name="wiba" id="wiba" class="form-control"
                                               placeholder="Wiba Compensation"/>
                                        <div class="error"></div> <!-- Error display for 'bill_reference' -->
                                    </div>
                                    <div class="form-group col-md-4 px-3">
                                        <label for="sick" class="custom_label_color">Sick Leave</label>
                                        <input type="text" name="sick" id="sick" class="form-control"
                                               placeholder="Sick Leave"/>
                                        <div class="error"></div> <!-- Error display for 'bill_reference' -->
                                    </div>
                                </div>
                                <div class="form-row mt-3">
                                    <div class="form-group col-md-4 px-3">
                                        <label for="date_of_accident" class="custom_label_color">Date of
                                            Accident/Incident
                                        </label>
                                        <input type="date" name="date_of_accident" id="date_of_accident"
                                               class="form-control"
                                               placeholder="Date of Accident/Incident"/>
                                        <div class="error"></div> <!-- Error display for 'expense_date' -->
                                    </div>
                                    <div class="form-group col-md-4 px-3">
                                        <label for="date_of_resumption" class="custom_label_color">Date of Resumption
                                        </label>
                                        <input type="date" name="date_of_resumption" id="date_of_resumption"
                                               class="form-control"
                                               placeholder="Date of Resumption"/>
                                        <div class="error"></div> <!-- Error display for 'expense_date' -->
                                    </div>
                                    <div class="form-group col-md-4 px-3">
                                        <label for="date_of_reporting" class="custom_label_color">Date of Reporting
                                        </label>
                                        <input type="date" name="date_of_reporting" id="date_of_reporting"
                                               class="form-control"
                                               placeholder="Date of Reporting"/>
                                        <div class="error"></div> <!-- Error display for 'expense_date' -->
                                    </div>
                                </div>
                                <div class="form-row mt-3">
                                    <div class="form-group col-md-4 px-3">
                                        <label for="time_location" class="custom_label_color">Time And Location</label>
                                        <input type="text" name="time_location" id="time_location" class="form-control"
                                               placeholder="Time And Location"/>
                                        <div class="error"></div> <!-- Error display for 'quantity' -->
                                    </div>
                                    <div class="form-group col-md-4 px-3">
                                        <label for="witnesses" class="custom_label_color">Witnesses</label>
                                        <input type="text" name="witnesses" id="witnesses" class="form-control"
                                               placeholder="Witnesses"/>
                                        <div class="error"></div> <!-- Error display for 'bill_reference' -->
                                    </div>
                                    <div class="form-group col-12 col-md-4 pl-md-3 mt-n2 mt-md-0">
                                        <label for="accident_document_attachment" class="custom_label_color">
                                            Attachment
                                        </label>

                                        <div class="custom-file">
                                            <input type="file" class="custom-file-input form1-label-colors"
                                                   id="accident_document_attachment" onchange="updateFileName()"/>
                                            <label class="custom-file-label form1-label-colors" id="fileLabel"
                                                   for="accident_document_attachment">
                                                Choose file ...
                                            </label>
                                        </div>
                                        <div class="error"></div>
                                    </div>
                                </div>
                                <div class="form-row mt-3">
                                    <div class="form-group col-md-12 px-3">
                                        <label for="details_notes" class="custom_label_color">Your Details</label>
                                        <textarea name="details_notes" id="details_notes" class="form-control" rows="4"
                                                  placeholder="Enter Your details notes here..."></textarea>
                                        <div class="error"></div>
                                    </div>
                                </div>

                                <div class="row pr-2 pr-md-2 pt-2 justify-content-end">
                                    <div class="col-4 text-right">
                                        <!--                                        <button type="submit" class="btn" style="background:#345E90; color:#fff">Back To List</button>-->
                                        <a t-attf-href="/accident_requests" class="btn btn-primary"
                                           style="background:#345E90; color:#fff;">
                                            Back to List
                                        </a>
                                        <button type="submit" class="btn" style="background:#345E90; color:#fff">Create
                                            Request
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div id="overlay"></div>
                <!--                <script src="https://code.jquery.com/jquery-3.6.0.min.js"/>-->
                <script src="https://cdn.jsdelivr.net/npm/sweetalert2@10"/>
                <script type="module" src="/kyan_employee_portal/static/src/js/accident_request.js"/>
                <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js"/>
                <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.9.0/js/bootstrap-datepicker.min.js"></script>
                <script type="script" src="kyan_employee_portal/static/src/js/overlay.js"/>
                <script>
                    function updateFileName() {
                    var fileInput = document.getElementById('accident_document_attachment');
                    var fileLabel = document.getElementById('fileLabel');
                    if (fileInput.files.length > 0) {
                    fileLabel.textContent = fileInput.files[0].name;
                    } else {
                    fileLabel.textContent = 'Choose file ...';
                    }
                    }
                </script>


            </body>
        </t>
    </template>
</odoo>

